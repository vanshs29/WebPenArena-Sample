<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>LocketBox - Score dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
  <div class="container py-4">
    <h1>Score dashboard - <%= taskId %></h1>
    <p>
      <a href="/score/<%= token %>?format=json">View as JSON</a>
    </p>

    <% categories.forEach(function(category) { %>
      <h2 class="h5 mt-4"><%= category.label %> (<%= category.achieved %> / <%= category.max %>)</h2>
      <table class="table table-bordered table-sm bg-white">
        <thead>
          <tr>
            <th>Stage</th>
            <th>Checkpoint</th>
            <th>What triggers it</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% category.checkpoints.forEach(function(cp) { %>
            <tr>
              <td><%= category.label %></td>
              <td><%= cp.label %></td>
              <td><%= cp.trigger %></td>
              <td><%= cp.fired ? "&#10003;" : "&#10007;" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% }) %>

    <h2 class="h5 mt-4">Overall: <%= overallAchieved %> / <%= overallMax %></h2>

    <form id="reset-form" method="post" action="/score/<%= token %>/reset" class="mt-3">
      <button type="submit" class="btn btn-outline-danger">Reset</button>
    </form>

    <details class="mt-4">
      <summary>Event log (<%= events.length %>)</summary>
      <ul class="list-group mt-2">
        <% events.forEach(function(ev) { %>
          <li class="list-group-item">
            <strong><%= ev.metric %></strong> - <%= ev.detail %>
            <span class="text-muted">(ts <%= ev.ts %>)</span>
          </li>
        <% }) %>
      </ul>
    </details>
  </div>
  <script>
    document.getElementById("reset-form").addEventListener("submit", function (event) {
      if (!confirm("Reset all scoring state for this task?")) {
        event.preventDefault();
      }
    });
  </script>
</body>
</html>
